<view class="page">
  <view class="hero auth-brand-area">
    <view class="glass-grid"></view><view class="glow-beam"></view>
    <view class="brand">
      <view class="brand-mark"><image class="logo-img" src="/images/logo.png" mode="aspectFit"></image></view>
      <view class="brand-copy"><text class="brand-name">筑安慧眼</text><text class="brand-en">智慧工地 · 安全协同</text></view>
    </view>
    <view class="glass-hero-copy"><text class="glass-headline">从这里开始，<text class="glass-headline-second">让安全更进一步。</text></text><text class="glass-description">加入筑安慧眼，守护每一个施工现场</text></view>
    <view class="glass-city" aria-hidden="true">
      <view class="glass-orbit"></view><view class="glass-tower tower-one"></view><view class="glass-tower tower-two"></view><view class="glass-tower tower-three"></view>
      <view class="glass-crane-mast"></view><view class="glass-crane-arm"></view><view class="glass-crane-wire"></view><view class="glass-crane-hook"></view><view class="glass-city-point"></view>
    </view>
  </view>
  <view class="login-panel register-panel">
    <view class="panel-heading">
      <view><text class="form-title">创建账号</text><text class="form-description">手机号验证后即可加入安全协同</text></view>
      <text class="auth-tag">新用户注册</text>
    </view>

    <view class="register-form">
      <view class="field-group">
        <text class="field-label">姓名</text>
        <view class="input-shell {{nameFocused ? 'is-focused' : ''}}">
          <view class="field-icon user-icon"><view></view></view>
          <input class="input" placeholder="请输入你的姓名" placeholder-class="input-placeholder" value="{{name}}" maxlength="30" bindinput="onNameInput" bindfocus="onNameFocus" bindblur="onNameBlur" />
        </view>
      </view>

      <view class="field-group">
        <text class="field-label">手机号</text>
        <view class="input-shell {{telFocused ? 'is-focused' : ''}}">
          <view class="field-icon phone-icon"><view></view></view>
          <input class="input" type="number" placeholder="请输入11位手机号" placeholder-class="input-placeholder" value="{{tel}}" maxlength="11" bindinput="onTelInput" bindfocus="onTelFocus" bindblur="onTelBlur" />
        </view>
      </view>

      <view class="field-group captcha-group">
        <text class="field-label">短信验证码</text>
        <view class="input-shell sms-shell {{codeFocused ? 'is-focused' : ''}}">
          <view class="field-icon verify-icon"><view></view></view>
          <input class="input sms-input" type="number" placeholder="请输入6位验证码" placeholder-class="input-placeholder" value="{{code}}" maxlength="6" bindinput="onCodeInput" bindfocus="onCodeFocus" bindblur="onCodeBlur" />
          <button class="sms-send {{countdown > 0 ? 'is-counting' : ''}}" bindtap="sendCode" disabled="{{countdown > 0 || sending}}" hover-class="sms-send-pressed">
            {{countdown > 0 ? countdown + 's 后重发' : (sending ? '发送中...' : '获取验证码')}}
          </button>
        </view>
        <view class="captcha-meta">
          <view class="sms-demo-note" wx:if="{{demoTip}}"><view class="demo-dot"></view><text>{{demoTip}}</text></view>
          <text class="captcha-hint" wx:else>{{countdown > 0 ? '验证码已发送，请查收短信' : '未收到？请检查手机号或稍后重试'}}</text>
        </view>
      </view>

      <view class="role-note">
        <text class="role-note-title">默认岗位：现场施工人员</text>
        <text class="role-note-desc">注册后由管理员在 Web 用户管理中调整岗位；初始密码为 123456。</text>
      </view>

      <button class="login-btn register-btn" bindtap="doRegister" wx:if="{{!submitting}}" hover-class="login-btn-pressed"><text>立即注册</text><view class="button-arrow"></view></button>
      <button class="login-btn disabled" disabled="{{true}}" wx:if="{{submitting}}"><view class="loading-ring"></view><text>注册中...</text></button>
      <view class="register-row"><text class="register-hint">已有账号？</text><view class="register-link" bindtap="goToLogin"><text>立即登录</text><view class="register-arrow"></view></view></view>
    </view>
  </view>
  <view class="panel-footer"><view class="footer-rule"></view><text>智能识别 · 协同整改 · 全程守护</text><view class="footer-rule"></view></view>
</view>
