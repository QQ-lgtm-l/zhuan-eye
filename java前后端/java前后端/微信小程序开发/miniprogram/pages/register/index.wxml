<view class="page">
  <view class="register-box">
    <image class="logo-img" src="/images/logo.png" mode="aspectFit"></image>
    <text class="title">筑安慧眼</text>
    <text class="subtitle">注册只需姓名、手机号和验证码</text>

    <view class="input-box">
      <view class="input-wrapper">
        <input
          class="input"
          placeholder=""
          value="{{name}}"
          bindinput="onNameInput"
          maxlength="20"
        />
        <text class="input-label {{name ? 'hidden' : ''}}">请输入姓名</text>
      </view>
    </view>

    <view class="input-box">
      <view class="input-wrapper">
        <input
          class="input"
          type="number"
          placeholder=""
          value="{{tel}}"
          bindinput="onTelInput"
          maxlength="11"
        />
        <text class="input-label {{tel ? 'hidden' : ''}}">请输入 11 位手机号</text>
      </view>
    </view>

    <view class="input-box role-select-box">
      <view class="picker-input" bindtap="toggleRole">
        <text class="{{role ? '' : 'picker-placeholder'}}">{{role || '请选择职位'}}</text>
        <text class="picker-arrow {{roleOpen ? 'open' : ''}}">▼</text>
      </view>
      <view class="role-dropdown" wx:if="{{roleOpen}}">
        <view
          wx:for="{{roleOptions}}"
          wx:key="*this"
          class="role-option {{role === item ? 'active' : ''}}"
          data-role="{{item}}"
          bindtap="selectRole"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view class="input-box">
      <view class="code-row">
        <view class="input-wrapper code-input">
          <input
            class="input"
            type="number"
            placeholder=""
            value="{{code}}"
            bindinput="onCodeInput"
            maxlength="6"
          />
          <text class="input-label {{code ? 'hidden' : ''}}">请输入验证码</text>
        </view>
        <view class="code-btn {{countdown > 0 || sending ? 'disabled' : ''}}" catchtap="sendCode">
          <text>{{countdown > 0 ? countdown + 's 后重发' : (sending ? '发送中' : '获取验证码')}}</text>
        </view>
      </view>
    </view>

    <view class="demo-tip" wx:if="{{demoTip}}">
      <text>{{demoTip}}</text>
    </view>

    <view class="register-btn" bindtap="doRegister" wx:if="{{!submitting}}">
      <text>注 册</text>
    </view>
    <view class="register-btn disabled" wx:if="{{submitting}}">
      <text>注册中...</text>
    </view>

    <view class="hint">
      <text>账号自动取姓名全拼，初始密码统一为 123456</text>
    </view>

    <view class="login-link" bindtap="goToLogin">
      <text>已有账号？立即登录</text>
    </view>
  </view>
</view>
