page {
  background: linear-gradient(135deg, #0D47A1 0%, #1565C0 100%);
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
}

.register-box {
  width: 100%;
  max-width: 680rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(20px);
}

.logo-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #0D47A1;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.input-box {
  margin-bottom: 24rpx;
}

.input-wrapper {
  position: relative;
}

.input {
  width: 100%;
  padding: 32rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background: #fafafa;
  transition: border-color 0.3s;
}

.input:focus {
  border-color: #0D47A1;
  background: #fff;
}

.input-label {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
  pointer-events: none;
  transition: all 0.3s;
}

.input-label.hidden {
  display: none;
}

.picker-input {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  background: #fafafa;
}

.picker-arrow {
  font-size: 36rpx;
  color: #999;
}

.register-btn {
  background: linear-gradient(135deg, #0D47A1 0%, #1565C0 100%);
  color: #fff;
  padding: 32rpx;
  border-radius: 44rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 12rpx 36rpx rgba(13, 71, 161, 0.4);
  margin-top: 32rpx;
  transition: transform 0.2s;
}

.register-btn:active {
  transform: scale(0.98);
}

.register-btn.disabled {
  background: #ccc;
  box-shadow: none;
  opacity: 0.6;
  pointer-events: none;
}

.login-link {
  margin-top: 36rpx;
}

.login-link text {
  font-size: 28rpx;
  color: #0D47A1;
}
.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.code-btn {
  flex: 0 0 220rpx;
  padding: 32rpx 0;
  border-radius: 16rpx;
  background: #e8f1fd;
  color: #0d47a1;
  font-size: 28rpx;
  text-align: center;
}

.code-btn.disabled {
  opacity: 0.55;
}

.demo-tip {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #f4f8fd;
  color: #5b6b82;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
}

.hint {
  margin-top: 24rpx;
  color: #93a2b5;
  font-size: 24rpx;
  line-height: 1.6;
}

.role-box {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fafafa;
  border: 2rpx solid #e8e8e8;
}

.role-label {
  display: block;
  margin-bottom: 12rpx;
  color: #5b6b82;
  font-size: 25rpx;
}

.role-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.role-item {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid #e3ecf7;
  color: #43536b;
  font-size: 24rpx;
}

.role-item.active {
  background: #0d47a1;
  border-color: #0d47a1;
  color: #fff;
}

.role-radio {
  display: none;
}

.picker-placeholder {
  color: #999;
}

.code-btn {
  position: relative;
  z-index: 3;
}

.role-select-box {
  position: relative;
  z-index: 20;
}

.role-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: 8rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 12rpx 30rpx rgba(15, 52, 96, 0.16);
  border: 2rpx solid #e8f1fd;
  overflow: hidden;
  z-index: 30;
}

.role-option {
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  color: #33445c;
  border-bottom: 1rpx solid #f2f6fb;
}

.role-option:last-child {
  border-bottom: none;
}

.role-option.active {
  color: #0d47a1;
  background: #e8f1fd;
  font-weight: bold;
}

.picker-arrow.open {
  transform: rotate(180deg);
}

.role-mask {
  position: fixed;
  inset: 0;
  z-index: 15;
}

/* 下拉列表改为普通文档流展开，不做浮层，避免遮挡点击 */
.role-select-box {
  position: static;
  z-index: auto;
}

.role-dropdown {
  position: static;
  margin-top: 8rpx;
  box-shadow: none;
  border: 2rpx solid #e8f1fd;
}

.role-mask {
  display: none;
}
