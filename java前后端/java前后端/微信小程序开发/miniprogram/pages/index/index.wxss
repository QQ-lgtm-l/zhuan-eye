.page {
  min-height: 100vh;
  background: #F5F9FF;
}

.header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #0D47A1 0%, #1565C0 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.greeting {
  display: flex;
  flex-direction: column;
}

.greeting-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.greeting-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.header-right {
  display: flex;
  align-items: center;
}

.notification-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.main {
  padding: 0 20rpx 40rpx;
  margin-top: -20rpx;
}

.chart-section {
  margin-bottom: 20rpx;
}

.chart-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #90CAF9;
  box-shadow: 0 4rpx 16rpx rgba(13, 71, 161, 0.1);
}

.card-header {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F7FF;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #0D47A1;
}

.chart-container {
  display: flex;
  justify-content: center;
  overflow: hidden;
}

.chart-canvas {
  display: block;
}

.chart-scroll {
  width: 100%;
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.table-scroll {
  width: 100%;
  height: 300rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.monitor-table {
  min-width: 100%;
}

.table-header {
  display: flex;
  background: #E3F2FD;
  padding: 16rpx 10rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  min-width: 100%;
}

.th {
  font-size: 24rpx;
  font-weight: bold;
  color: #1565C0;
  text-align: center;
}

.th.username {
  flex: 1;
  min-width: 120rpx;
}

.th.weight {
  flex: 1;
  min-width: 120rpx;
}

.th.conf {
  flex: 1;
  min-width: 120rpx;
}

.th.time {
  flex: 1.5;
  min-width: 200rpx;
}

.table-body {
  min-width: 100%;
}

.table-row {
  display: flex;
  padding: 14rpx 10rpx;
  border-bottom: 1rpx solid #F0F7FF;
  min-width: 100%;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  font-size: 22rpx;
  color: #333;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.td.username {
  flex: 1;
  min-width: 120rpx;
}

.td.weight {
  flex: 1;
  min-width: 120rpx;
}

.td.conf {
  flex: 1;
  min-width: 120rpx;
}

.td.time {
  flex: 1.5;
  min-width: 200rpx;
  color: #999;
}

.table-empty {
  text-align: center;
  padding: 40rpx;
  color: #90CAF9;
  font-size: 24rpx;
}

.no-charts {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  background: #fff;
  margin-top: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #90CAF9;
}

.no-charts-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.no-charts-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.no-charts-desc {
  font-size: 26rpx;
  color: #999;
}
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(15, 52, 96, 0.06);
}

.quick-icon {
  font-size: 40rpx;
  margin-right: 14rpx;
}

.quick-text {
  display: flex;
  flex-direction: column;
}

.quick-title {
  font-size: 27rpx;
  font-weight: bold;
  color: #1b2c44;
}

.quick-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #93a2b5;
}
