<view class="page">
  <view class="header">
    <text class="title">摄像检测</text>
    <text class="subtitle">实时拍摄进行安全隐患识别</text>
  </view>

  <view class="main">
    <view class="settings-section">
      <view class="setting-item">
        <text class="setting-label">选择模型</text>
        <view class="model-select" bindtap="showModelPicker">
          <text class="model-text">{{selectedModel || '请选择模型'}}</text>
          <text class="model-arrow">›</text>
        </view>
      </view>
      <view class="setting-item">
        <text class="setting-label">置信度阈值</text>
        <view class="slider-container">
          <slider 
            class="conf-slider" 
            :value="confValue" 
            :min="0" 
            :max="100" 
            :step="5" 
            activeColor="#0D47A1"
            backgroundColor="#E3F2FD"
            block-size="24"
            bindchange="onConfChange"
          />
          <text class="conf-value">{{confValue}}%</text>
        </view>
      </view>
    </view>

    <view class="camera-section">
      <view class="camera-box" bindtap="takePhotoAndDetect" wx:if="{{!imagePath}}">
        <view class="camera-icon">📹</view>
        <text class="camera-text">点击拍摄</text>
        <text class="camera-hint">打开相机进行实时拍摄检测</text>
      </view>

      <view class="preview-box" wx:if="{{imagePath}}">
        <image src="{{imagePath}}" mode="aspectFit" class="preview-img"></image>
        <view class="preview-actions">
          <view class="preview-btn" bindtap="takePhotoAndDetect">重新拍摄</view>
          <view class="preview-btn danger" bindtap="reset">清空</view>
        </view>
      </view>

      <view class="action-box">
        <view class="action-btn" bindtap="takePhotoAndDetect" wx:if="{{!isDetecting}}">
          <text>{{imagePath ? '再次检测' : '开始拍摄检测'}}</text>
        </view>
        <view class="action-btn disabled" wx:if="{{isDetecting}}">
          <text>检测中...</text>
        </view>
      </view>
    </view>

    <view class="result-section" wx:if="{{showResult && result}}">
      <text class="section-title">检测结果</text>
      
      <view class="result-card" wx:if="{{result.outImg}}">
        <image src="{{result.outImg}}" mode="aspectFit" class="result-img"></image>
      </view>

      <view class="result-info">
        <view class="info-row">
          <text class="info-label">识别结果：</text>
          <text class="info-value">{{result.label || '未检测到隐患'}}</text>
        </view>
        
        <view class="info-row">
          <text class="info-label">置信度：</text>
          <text class="info-value">{{result.confidence || '-'}}</text>
        </view>
        
        <view class="info-row" wx:if="{{result.suggestion}}">
          <text class="info-label">整改建议：</text>
          <text class="info-value">{{result.suggestion}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showModelPicker}}" class="picker-modal" bindtap="hideModelPicker">
    <view class="picker-content" catchtap="onPickerContentTap">
      <view class="picker-header">
        <text class="picker-title">选择模型</text>
        <text class="picker-close" bindtap="hideModelPicker">×</text>
      </view>
      <view class="picker-list">
        <view 
          class="picker-item {{item.value === selectedModel ? 'active' : ''}}" 
          wx:for="{{modelList}}" 
          wx:key="value"
          bindtap="selectModel"
          data-value="{{item.value}}"
        >
          <text class="picker-item-text">{{item.label}}</text>
          <text class="picker-item-check" wx:if="{{item.value === selectedModel}}">✓</text>
        </view>
      </view>
    </view>
  </view>
</view>
