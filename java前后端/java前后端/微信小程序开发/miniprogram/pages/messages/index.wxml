<view class="page">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <text class="header-title">消息中心</text>
      <text class="header-subtitle">实时接收安全预警和工单通知</text>
      <view class="header-actions">
        <text class="mark-all-btn" bindtap="markAllRead">{{unreadCount > 0 ? unreadCount + '条未读' : '全部已读'}}</text>
        <text class="clear-btn" bindtap="clearAll">清空</text>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view 
      class="tab-item {{activeTab === item.id ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="id"
      bindtap="switchTab"
      data-id="{{item.id}}"
    >
      <text>{{item.name}}</text>
      <view wx:if="{{item.id === 'unread' && badgeCounts[item.id] > 0}}" class="tab-badge">
        {{badgeCounts[item.id]}}
      </view>
    </view>
  </view>

  <view class="main">
    <view class="message-list">
      <view 
        class="message-item {{item.isRead ? 'read' : ''}}" 
        wx:for="{{filteredMessages}}" 
        wx:key="id"
      >
        <view class="message-main" bindtap="viewDetail" data-item="{{item}}">
          <view class="message-icon {{item.type}}">
            <text>{{item.type === 'warning' ? '⚠️' : item.type === 'success' ? '✅' : '📢'}}</text>
          </view>
          <view class="message-content">
            <view class="message-header">
              <text class="message-title">{{item.title}}</text>
              <text class="message-time">{{item.createTime || item.time}}</text>
            </view>
            <text class="message-text">{{item.content}}</text>
          </view>
          <view wx:if="{{item.read === 0}}" class="message-dot"></view>
        </view>
        <view class="message-delete" bindtap="deleteMessage" data-id="{{item.id}}">
          <text>删除</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!isLoading && filteredMessages.length === 0}}" class="empty">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无消息</text>
    </view>

    <view wx:if="{{isLoading}}" class="loading">
      <text>加载中...</text>
    </view>
  </view>

  <view wx:if="{{showDetail}}" class="detail-modal" bindtap="closeDetail">
    <view class="detail-content" catchtap="closeDetail">
      <view class="detail-header">
        <text class="detail-title">消息详情</text>
        <text class="detail-close" bindtap="closeDetail">×</text>
      </view>
      <view class="detail-body">
        <view class="detail-icon {{detailData.type}}">
          <text>{{detailData.type === 'warning' ? '⚠️' : detailData.type === 'success' ? '✅' : '📢'}}</text>
        </view>
        <view class="detail-title-text">{{detailData.title}}</view>
        <view class="detail-info">
          <view class="info-row">
            <text class="info-label">消息类型</text>
            <text class="info-value">{{detailData.type === 'warning' ? '预警' : detailData.type === 'success' ? '完成' : '通知'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">发送时间</text>
            <text class="info-value">{{detailData.createTime || detailData.time || '-'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">消息内容</text>
            <text class="info-value">{{detailData.content || '-'}}</text>
          </view>
        </view>
      </view>
      <view class="detail-footer">
        <view class="detail-btn" bindtap="closeDetail">关闭</view>
        <view class="detail-btn primary" bindtap="goToWorkOrder">去处理</view>
      </view>
    </view>
  </view>
</view>