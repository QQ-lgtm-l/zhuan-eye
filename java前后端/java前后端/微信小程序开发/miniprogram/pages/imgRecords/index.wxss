page {
  background: #f5f7fa;
  min-height: 100vh;
}

.page {
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #0D47A1;
}

.search-section {
  margin-bottom: 30rpx;
}

.search-box {
  display: flex;
  gap: 15rpx;
  background: #fff;
  padding: 15rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  padding: 20rpx;
  font-size: 28rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
}

.search-btn {
  padding: 20rpx 30rpx;
  background: #0D47A1;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.main {
  padding-bottom: 40rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 25rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.record-img-box {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.record-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}

.record-label {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.record-confidence {
  font-size: 26rpx;
  color: #0D47A1;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-user {
  font-size: 24rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-state {
  text-align: center;
  padding: 40rpx;
}

.loading-state text {
  font-size: 28rpx;
  color: #999;
}

.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.detail-content {
  width: 100%;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  max-height: 85vh;
  overflow: hidden;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.detail-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.detail-body {
  max-height: calc(85vh - 80rpx);
}

.detail-images {
  padding: 20rpx;
}

.image-item {
  margin-bottom: 20rpx;
}

.image-item:last-child {
  margin-bottom: 0;
}

.image-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
  padding-left: 10rpx;
}

.detail-img {
  width: 100%;
  border-radius: 12rpx;
}

.detail-info {
  padding: 0 30rpx 30rpx;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.info-row.long .info-value {
  display: block;
  margin-top: 10rpx;
}
