.page {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  background: #fff;
  padding: 60rpx 30rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.main {
  padding: 30rpx;
}

.about-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0D47A1 0%, #1565C0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.logo text {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.app-subtitle {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}

.info-section {
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #0D47A1;
}

.description-section {
  margin-bottom: 40rpx;
}

.description-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}

.description-text:last-child {
  margin-bottom: 0;
}

.features-section {
  margin-bottom: 40rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.tech-section {
  margin-bottom: 40rpx;
}

.tech-list {
  padding-left: 10rpx;
}

.tech-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.tech-item:last-child {
  border-bottom: none;
}

.tech-label {
  font-size: 28rpx;
  color: #999;
}

.tech-value {
  font-size: 26rpx;
  color: #333;
}

.copyright {
  text-align: center;
  padding-top: 30rpx;
  border-top: 1rpx solid #f5f5f5;
}

.copyright text {
  font-size: 24rpx;
  color: #999;
}