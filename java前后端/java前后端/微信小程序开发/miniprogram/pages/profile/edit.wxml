<view class="page">
  <view class="header">
    <text class="header-title">编辑资料</text>
  </view>

  <view class="main">
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">头像</text>
        <view class="avatar-upload" bindtap="chooseAvatar">
          <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-img" mode="aspectFill" />
          <view wx:else class="avatar-placeholder">
            <text class="avatar-icon">+</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">账号</text>
        <input class="form-input" type="text" placeholder="账号由系统生成" disabled value="{{form.username}}" />
      </view>

      <view class="form-item">
        <text class="form-label">密码</text>
        <input class="form-input" type="password" placeholder="留空则不修改密码" bindinput="onPasswordInput" value="{{form.password}}" />
      </view>

      <view class="form-item">
        <text class="form-label">姓名</text>
        <input class="form-input" type="text" placeholder="请输入姓名" bindinput="onNameInput" value="{{form.name}}" />
      </view>

      <view class="form-item">
        <text class="form-label">性别</text>
        <picker mode="selector" range="{{sexOptions}}" bindchange="onSexChange">
          <view class="form-picker">
            <text>{{form.sex || '请选择性别'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" bindinput="onTelInput" value="{{form.tel}}" />
      </view>

      <view class="form-item">
        <text class="form-label">角色</text>
        <input class="form-input" type="text" placeholder="角色由管理员分配" disabled value="{{form.role}}" />
      </view>
    </view>

    <view class="hint">
      <text>密码留空表示不修改；如需修改请输入 6-30 位且同时包含字母和数字。</text>
    </view>

    <view class="submit-btn" bindtap="submit">
      <text>确认修改</text>
    </view>
  </view>
</view>
