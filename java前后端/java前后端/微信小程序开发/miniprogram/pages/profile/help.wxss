.page {
  min-height: 100vh;
  background: #f5f7fa;
}

.header {
  background: #fff;
  padding: 60rpx 30rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.main {
  padding: 30rpx;
}

.help-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.help-section {
  margin-bottom: 40rpx;
}

.help-section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #0D47A1;
}

.title-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.help-list {
  padding-left: 10rpx;
}

.help-item {
  margin-bottom: 20rpx;
}

.help-item:last-child {
  margin-bottom: 0;
}

.help-question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
}

.expand-icon {
  font-size: 36rpx;
  color: #0D47A1;
  font-weight: bold;
}

.help-answer {
  padding: 0 0 20rpx 20rpx;
  border-left: 4rpx solid #E3F2FD;
  margin-left: 10rpx;
}

.help-answer text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.help-answer text:last-child {
  margin-bottom: 0;
}

.contact-info {
  padding-left: 10rpx;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 28rpx;
  color: #999;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
}