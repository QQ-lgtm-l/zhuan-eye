<view class="page">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="user-card">
        <view class="avatar">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{userInfo.name ? userInfo.name.slice(0, 1) : '用'}}</text>
        </view>
        <view class="user-info">
          <text class="user-name">{{userInfo.name || '用户'}}</text>
          <text class="user-role">{{userInfo.role || '未知角色'}}</text>
          <text class="role-desc">{{roleDesc[userInfo.role] || ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="main">
    <view class="menu-card">
      <view 
        class="menu-item" 
        wx:for="{{menuItems}}" 
        wx:key="id"
        bindtap="navigateTo"
        data-id="{{item.id}}"
      >
        <view class="menu-icon" style="background: {{item.color}}15">
          <text>{{item.icon}}</text>
        </view>
        <text class="menu-name">{{item.name}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="info-card">
      <view class="info-title">账号信息</view>
      <view class="info-item">
        <text class="info-label">用户名</text>
        <text class="info-value">{{userInfo.username || '-'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">姓名</text>
        <text class="info-value">{{userInfo.name || '-'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">性别</text>
        <text class="info-value">{{userInfo.sex || '-'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">手机号</text>
        <text class="info-value">{{userInfo.tel || '-'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">邮箱</text>
        <text class="info-value">{{userInfo.email || '-'}}</text>
      </view>
    </view>

    <view class="logout-btn" bindtap="logout">
      <text>退出登录</text>
    </view>
  </view>
</view>