page {
  background: linear-gradient(135deg, #0D47A1 0%, #1565C0 100%);
  min-height: 100vh;
}

.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx;
}

.login-box {
  width: 100%;
  max-width: 680rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(20px);
}

.logo-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #0D47A1;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.input-box {
  margin-bottom: 32rpx;
}

.input-wrapper {
  position: relative;
}

.input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  background: #fafafa;
  transition: border-color 0.3s;
  display: flex;
  align-items: center;
  text-align: left;
}

.input:focus {
  border-color: #0D47A1;
  background: #fff;
}

.input-label {
  position: absolute;
  left: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
  pointer-events: none;
  transition: all 0.3s;
  line-height: 96rpx;
}

.input-label.hidden {
  display: none;
}

.toggle-password {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.toggle-password:active {
  opacity: 0.6;
}

.eye-icon {
  width: 40rpx;
  height: 40rpx;
}

.input-with-toggle {
  padding-right: 90rpx !important;
}

.picker {
  width: 100%;
  padding: 28rpx 32rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  background: #fafafa;
}

.picker text {
  flex: 1;
}

.picker .arrow {
  color: #999;
  font-size: 40rpx;
}

.remember-box {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s;
}

.checkbox.checked {
  background: #0D47A1;
  border-color: #0D47A1;
}

.checkbox.checked text {
  color: #fff;
  font-size: 24rpx;
}

.remember-text {
  font-size: 28rpx;
  color: #666;
}

.login-btn {
  background: linear-gradient(135deg, #0D47A1 0%, #1565C0 100%);
  color: #fff;
  padding: 32rpx;
  border-radius: 44rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 12rpx 36rpx rgba(13, 71, 161, 0.4);
  transition: transform 0.2s;
}

.login-btn:active {
  transform: scale(0.98);
}

.login-btn.disabled {
  background: #ccc;
  box-shadow: none;
  transform: none;
}

.register-link {
  margin-top: 36rpx;
}

.register-link text {
  font-size: 28rpx;
  color: #0D47A1;
}