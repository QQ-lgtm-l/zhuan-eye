<view class="page">
  <view class="login-box">
    <image class="logo-img" src="/images/logo.png" mode="aspectFit"></image>
    <text class="title">筑安慧眼</text>
    <text class="subtitle">基于视觉驱动多Agent的房建施工现场隐患闭环协同管控系统</text>

    <view class="login-form">
      <view class="input-box">
        <view class="input-wrapper">
          <input 
            class="input" 
            placeholder="" 
            placeholder-class="placeholder"
            value="{{username}}" 
            bindinput="onUsernameInput"
            bindfocus="onUsernameFocus"
            bindblur="onUsernameBlur"
          />
          <text class="input-label {{username || usernameFocused ? 'hidden' : ''}}">请输入用户名</text>
        </view>
      </view>

      <view class="input-box">
        <view class="input-wrapper">
          <input 
            class="input input-with-toggle" 
            placeholder="" 
            placeholder-class="placeholder"
            password="{{!showPassword}}"
            value="{{password}}" 
            bindinput="onPasswordInput"
            bindfocus="onPasswordFocus"
            bindblur="onPasswordBlur"
          />
          <text class="input-label {{password || passwordFocused ? 'hidden' : ''}}">请输入密码</text>
          <view class="toggle-password" catchtap="togglePassword">
            <image class="eye-icon" src="{{showPassword ? '/images/eye_open.svg' : '/images/eye_close.svg'}}" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <view class="remember-box" bindtap="toggleRemember">
        <view class="checkbox {{rememberPassword ? 'checked' : ''}}">
          <text wx:if="{{rememberPassword}}">✓</text>
        </view>
        <text class="remember-text">记住密码</text>
      </view>

      <view class="login-btn" bindtap="doAccountLogin" wx:if="{{!isLogging}}">
        <text>登录</text>
      </view>
      <view class="login-btn disabled" wx:if="{{isLogging}}">
        <text>登录中...</text>
      </view>

      <view class="register-link" bindtap="goToRegister">
        <text>没有账号？立即注册</text>
      </view>
    </view>
  </view>
</view>