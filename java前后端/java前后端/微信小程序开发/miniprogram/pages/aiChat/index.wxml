<view class="chat-page">
  <view class="chat-head">
    <text class="chat-title">筑安慧眼 · 安全问答</text>
    <text class="chat-status">{{statusLabel}}{{statusModel ? ' · ' + statusModel : ''}}</text>
  </view>

  <scroll-view class="chat-body" scroll-y scroll-top="{{scrollTop}}">
    <view wx:for="{{messages}}" wx:key="index" class="msg-row {{item.role === 'user' ? 'is-user' : 'is-assistant'}}">
      <view class="bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{loading}}" class="msg-row is-assistant">
      <view class="bubble loading">思考中...</view>
    </view>
  </scroll-view>

  <view class="suggest-row" wx:if="{{messages.length <= 1}}">
    <view class="suggest" wx:for="{{suggestions}}" wx:key="index" data-text="{{item}}" bindtap="useSuggestion">
      {{item}}
    </view>
  </view>

  <view class="input-bar">
    <input class="chat-input" value="{{input}}" placeholder="输入安全问题，如：临边防护怎么做？" bindinput="onInput" confirm-type="send" bindconfirm="send" />
    <view class="send-btn {{loading || !input ? 'disabled' : ''}}" bindtap="send">发送</view>
  </view>
</view>
