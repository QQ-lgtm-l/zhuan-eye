<view class="page">
  <view class="header">
    <text class="title">批量检测</text>
    <text class="subtitle">上传多张图片进行批量安全隐患识别</text>
  </view>

  <view class="main">
    <view class="settings-section">
      <view class="setting-item">
        <text class="setting-label">选择模型</text>
        <view class="model-select" bindtap="showModelPicker">
          <text class="model-text">{{selectedModel || '请选择模型'}}</text>
          <text class="model-arrow">›</text>
        </view>
      </view>
      <view class="setting-item">
        <text class="setting-label">置信度阈值</text>
        <view class="slider-container">
          <slider 
            class="conf-slider" 
            :value="confValue" 
            :min="0" 
            :max="100" 
            :step="5" 
            activeColor="#0D47A1"
            backgroundColor="#E3F2FD"
            block-size="24"
            bindchange="onConfChange"
          />
          <text class="conf-value">{{confValue}}%</text>
        </view>
      </view>
    </view>

    <view class="upload-section">
      <view class="upload-box" bindtap="chooseImages" wx:if="{{!imagePaths || imagePaths.length === 0}}">
        <view class="upload-icon">📁</view>
        <text class="upload-text">点击选择图片</text>
        <text class="upload-hint">支持选择多张图片（最多9张）</text>
      </view>

      <view class="images-grid" wx:if="{{imagePaths && imagePaths.length > 0}}">
        <view class="image-item" wx:for="{{imagePaths}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" class="image-thumb"></image>
          <view class="remove-btn" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view class="image-item add" bindtap="chooseImages" wx:if="{{imagePaths.length < 9}}">
          <view class="add-icon">+</view>
        </view>
      </view>

      <view class="action-box">
        <view class="action-btn" bindtap="uploadAndRecognize" wx:if="{{imagePaths.length > 0 && !isUploading}}">
          <text>批量检测 ({{imagePaths.length}}张)</text>
        </view>
        <view class="action-btn disabled" wx:if="{{imagePaths.length === 0 || isUploading}}">
          <text>{{isUploading ? '检测中...' : '请选择图片'}}</text>
        </view>
        
        <view class="reset-btn" bindtap="reset" wx:if="{{imagePaths.length > 0}}">
          <text>清空全部</text>
        </view>
      </view>
    </view>

    <view class="result-section" wx:if="{{showResults && results.length > 0}}">
      <text class="section-title">检测结果</text>
      
      <view class="results-list">
        <view class="result-item" wx:for="{{results}}" wx:key="index">
          <view class="result-header">
            <text class="result-index">第{{item.index}}张</text>
            <text class="level-tag {{item.hazardLevel === '重大隐患' ? 'danger' : item.hazardLevel === '较大隐患' ? 'warning' : 'normal'}}" wx:if="{{item.hazardLevel}}">{{item.hazardLevel}}</text>
          </view>
          <view class="result-images">
            <image src="{{item.original}}" mode="aspectFit" class="result-img"></image>
            <image src="{{item.outImg}}" mode="aspectFit" class="result-img" wx:if="{{item.outImg}}"></image>
          </view>
          <view class="result-info">
            <!-- 多隐患标签 -->
            <view class="info-row" wx:if="{{item.hazardList.length > 0}}">
              <text class="info-label">识别结果：</text>
              <view class="hazard-tags">
                <view class="hazard-tag" wx:for="{{item.hazardList}}" wx:for-item="hz" wx:key="idx" wx:for-index="idx">
                  <text class="hazard-tag-label">{{hz.label}}</text>
                  <text class="hazard-tag-conf">{{hz.confidence}}</text>
                </view>
              </view>
            </view>
            <view class="info-row" wx:elif="{{item.hazardList.length === 0}}">
              <text class="info-label">识别结果：</text>
              <text class="info-value">未检测到隐患</text>
            </view>

            <view class="info-row">
              <text class="info-label">检测时间：</text>
              <text class="info-value">{{item.allTime}}</text>
            </view>

            <!-- 检测详情 -->
            <view class="detail-section" wx:if="{{item.detailList.length > 0}}">
              <view class="detail-title">检测详情（共{{item.detailList.length}}项）</view>
              <view class="detail-table">
                <view class="detail-header-row">
                  <text class="detail-col-label">类别</text>
                  <text class="detail-col-conf">置信度</text>
                  <text class="detail-col-type">类型</text>
                  <text class="detail-col-source">来源</text>
                </view>
                <view class="detail-row {{det.typeClass}}" wx:for="{{item.detailList}}" wx:for-item="det" wx:key="didx" wx:for-index="didx">
                  <text class="detail-col-label">{{det.hazard_type}}</text>
                  <text class="detail-col-conf">{{det.confidence}}</text>
                  <text class="detail-col-type">{{det.typeLabel}}</text>
                  <text class="detail-col-source">{{det.sourceLabel}}</text>
                </view>
              </view>
            </view>

            <!-- 整改建议 -->
            <view class="suggestion-section" wx:if="{{item.suggestion}}">
              <text class="info-label">整改建议：</text>
              <view class="suggestion-content">
                <text class="suggestion-text">{{item.suggestion}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showModelPicker}}" class="picker-modal" bindtap="hideModelPicker">
    <view class="picker-content" catchtap="onPickerContentTap">
      <view class="picker-header">
        <text class="picker-title">选择模型</text>
        <text class="picker-close" bindtap="hideModelPicker">×</text>
      </view>
      <view class="picker-list">
        <view 
          class="picker-item {{item.value === selectedModel ? 'active' : ''}}" 
          wx:for="{{modelList}}" 
          wx:key="value"
          bindtap="selectModel"
          data-value="{{item.value}}"
        >
          <text class="picker-item-text">{{item.label}}</text>
          <text class="picker-item-check" wx:if="{{item.value === selectedModel}}">✓</text>
        </view>
      </view>
    </view>
  </view>
</view>
